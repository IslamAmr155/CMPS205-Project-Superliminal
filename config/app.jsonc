{
    "start-scene": "menu",
    "window":
    {
        "title":"Superliminal",
        "size":{
            "width":1280,
            "height":720
        },
        "fullscreen": false
    },
    "scene": {
        "renderer":{
            "sky": "assets/textures/sky.jpg",
            "postprocess": "assets/shaders/postprocess/edge-detection.frag"
        },
        "assets":{
            "shaders":{
                "tinted":{
                    "vs":"assets/shaders/tinted.vert",
                    "fs":"assets/shaders/tinted.frag"
                },
                "textured":{
                    "vs":"assets/shaders/textured.vert",
                    "fs":"assets/shaders/textured.frag"
                },
                "lit":{
                    "vs":"assets/shaders/lit.vert",
                    "fs":"assets/shaders/lit.frag"
                }
            },
            "textures":{
                "moon": "assets/textures/moon.jpg",
                "grass": "assets/textures/grass_ground_d.jpg",
                "wood": "assets/textures/wood.jpg",
                "glass": "assets/textures/glass-panels.png",
                "monkey": "assets/textures/monkey.png",

                "house": "assets/textures/house.jpg",
                "house_albedo": "assets/textures/house_albedo.jpg",
                "house_specular": "assets/textures/house_specular.jpg",
                "house_ambient_occlusion": "assets/textures/house_ambient_occlusion.jpg",
                "house_roughness": "assets/textures/house_roughness.jpg",
                "house_emissive": "assets/textures/house_emissive.jpg",

                "black": "assets/textures/black.jpg",

                "floor": "assets/textures/metal_floor.png",
                "chamber_wall": "assets/textures/chamber_wall_panel.png",
                "toy_block": "assets/textures/toy_block.png",
                "door": "assets/textures/door.png",
                "ceiling": "assets/textures/ceiling_ambient_occlusion.png",
                "floor_ambient_occlusion": "assets/textures/floor_ambient_occlusion.png",
                "ceiling_ambient_occlusion": "assets/textures/ceiling_ambient_occlusion.png",
                "metal_specular": "assets/textures/metal_specular.png",
                "toy_block_ambient_occlusion": "assets/textures/toy_block_ambient_occlusion.png"
            },
            "meshes":{
                "cube": "assets/models/cube.obj",
                "monkey": "assets/models/monkey.obj",
                "plane": "assets/models/plane.obj",
                "sphere": "assets/models/sphere.obj",
                "floor": "assets/models/museum_floor.obj",
                "chamber_wall": "assets/models/chamber_wall.obj",
                "toy_block": "assets/models/toy_block.obj",
                "button_base": "assets/models/button_base.obj",
                "button": "assets/models/button.obj",
                "door": "assets/models/door_2.obj"
            },
            "samplers":{
                "default":{},
                "pixelated":{
                    "MAG_FILTER": "GL_NEAREST"
                },
                "repeated":{
                    "WRAP_S": "GL_REPEAT",
                    "WRAP_T": "GL_REPEAT"
                }
            },
            "materials":{
                "metal":{
                    "type": "tinted",
                    "shader": "tinted",
                    "pipelineState": {
                        "faceCulling":{
                            "enabled": false
                        },
                        "depthTesting":{
                            "enabled": true
                        }
                    },
                    "tint": [0.45, 0.4, 0.5, 1]
                },
                "glass":{
                    "type": "textured",
                    "shader": "textured",
                    "pipelineState": {
                        "faceCulling":{
                            "enabled": false
                        },
                        "depthTesting":{
                            "enabled": true
                        },
                        "blending":{
                            "enabled": true,
                            "sourceFactor": "GL_SRC_ALPHA",
                            "destinationFactor": "GL_ONE_MINUS_SRC_ALPHA"
                        },
                        "depthMask": false
                    },
                    "transparent": true,
                    "tint": [1, 1, 1, 1],
                    "texture": "glass",
                    "sampler": "pixelated"
                },
                "floor":{
                    "type": "tinted",
                    "shader": "tinted",
                    "pipelineState": {
                        "faceCulling":{
                            "enabled": false
                        },
                        "depthTesting":{
                            "enabled": true
                        }
                    },
                    "texture": "floor"
                },
                "chamber_wall":{
                    // "type": "textured",
                    "type": "lit",
                    "shader": "lit",
                    "pipelineState": {
                        "faceCulling":{
                            "enabled": false
                        },
                        "depthTesting":{
                            "enabled": true
                        }
                    },
                    // "tint": [1, 1, 1, 1],
                    // "texture": "monkey",
                    // "texture": "house",
                    // "sampler": "default",
                    "albedo": "chamber_wall",
                    "albedo_tint": [1, 1, 1],
                    "specular": "black",
                    "specular_tint": [1, 1, 1],
                    "ambient_occlusion": "black",
                    "roughness": "black",
                    "roughness_range": [0.0, 1.0],
                    "emissive": "black",
                    "emissive_tint": [1, 1, 1],
                    // "texture": "chamber_wall",
                    "sampler": "repeated"
                },
                "toy_block":{
                    "type": "lit",
                    "shader": "lit",
                    "pipelineState": {
                        "faceCulling":{
                            "enabled": false
                        },
                        "depthTesting":{
                            "enabled": true
                        }
                    },
                    "albedo": "toy_block",
                    "albedo_tint": [1, 1, 1],
                    "specular": "black",
                    "specular_tint": [0, 0, 0],
                    "ambient_occlusion": "toy_block_ambient_occlusion",
                    "roughness": "black",
                    "roughness_range": [0.0, 1.0],
                    "emissive": "black",
                    "emissive_tint": [1, 1, 1]
                },
                "button":{
                    "type": "tinted",
                    "shader": "tinted",
                    "pipelineState": {
                        "faceCulling":{
                            "enabled": false
                        },
                        "depthTesting":{
                            "enabled": true
                        }
                    },
                    "tint": [0.8, 0.8, 0, 1]
                }, 
                "button_base": {
                    "type": "tinted",
                    "shader": "tinted",
                    "pipelineState": {
                        "faceCulling":{
                            "enabled": false
                        },
                        "depthTesting":{
                            "enabled": true
                        }
                    },
                    "tint": [0.5, 0.5, 0.5, 1]
                }, 
                "door": {
                    "type": "tinted",
                    "shader": "tinted",
                    "pipelineState": {
                        "faceCulling":{
                            "enabled": false
                        },
                        "depthTesting":{
                            "enabled": true
                        }
                    },
                    "tint": [0.5, 0.5, 0.5, 1]
                },
                "ceiling": {
                    "type": "textured",
                    "shader": "textured",
                    "pipelineState": {
                        "faceCulling":{
                            "enabled": false
                        },
                        "depthTesting":{
                            "enabled": true
                        }
                    },
                    "texture": "ceiling"
                }
            }
        },
        "physicsWorld": {
            "gravity": [0, -5.0, 0]
        },
        "world":[
            {
                "position": [2, 0, 0],
                "components": [
                    {
                        "type": "Camera"
                    },
                    {
                        "type": "Free Camera Controller"
                    },
                    {
                        "type": "Rigid Body",       // rigid body component for the player to allow collisions and physics interactions
                        "rb_type": "Dynamic",       // static body for the floor, a kinematic body for a moving platform and a dynamic body for a rock that could fall on the floor.
                        "enableGravity": true,      // enable gravity for the player (default is true)
                        "allowedToSleep": false,    // sleeping technique is used to disable the simulation of resting bodies.
                        "rotationAxis": [1, 1, 1],
                        "motionAxis": [1, 1, 1],
                        // "relativePosition": [0, 1, 0],
                        "collider": {
                            "type": "Capsule Collider",
                            "radius": 0.5,
                            "height": 2.0,
                            "bounciness": 0.0,
                            "friction": 1.0,
                            "isTrigger": false              // is the collider a trigger (default is false)
                        }
                    }
                ]
